@@ -5668,6 +5668,15 @@ void multibus_storager_device::floppy_swap_cb(floppy_image_device *)
 
 void multibus_storager_device::device_start()
 {
+	// A media swap invalidates the cached density/geometry probe: the SINIX installer
+	// prompts for the next diskette mid-run, and the new medium may differ.
+	for (int i = 0; i < 2; i++)
+		if (floppy_image_device *const fdd = m_floppy[i]->get_device())
+		{
+			fdd->setup_load_cb(floppy_image_device::load_cb(&multibus_storager_device::floppy_swap_cb, this));
+			fdd->setup_unload_cb(floppy_image_device::unload_cb(&multibus_storager_device::floppy_swap_cb, this));
+		}
+
 	m_lram = std::make_unique<u16[]>(0x2000);
 	save_pointer(NAME(m_lram), 0x2000);
 	save_item(NAME(m_ch));
